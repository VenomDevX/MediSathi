# Copy to .env (never commit .env). Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MEDISAATHI_SECRET=
DATABASE_URL=postgresql+psycopg://medisaathi:medisaathi-dev@localhost:5432/medisaathi
DEMO_PASSWORD=demo-1234
CORS_ORIGINS=http://localhost:3100,http://localhost:4200,http://localhost:5173,http://localhost:4173,capacitor://localhost,http://localhost,https://localhost
# Optional: online explanations with Google Gemini (prototype). Leave empty to keep the app fully offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google sign-in (optional): the Web OAuth client ID from Google Cloud. Same value as frontend VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
